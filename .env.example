# =====================================================
# Application
# =====================================================

HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
TIME_ZONE=UTC


# =====================================================
# PostgreSQL
# =====================================================

POSTGRES_USER=test-user-123
POSTGRES_PASSWORD=test-postgres-password-456
POSTGRES_DB=test-db
POSTGRES_TIMEOUT=10s

# =====================================================
# Redis
# =====================================================

REDIS_ADDR=localhost:6379
REDIS_USERNAME=your_redis_username
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_TIMEOUT=5s


# =====================================================
# Logging
# =====================================================

LOGGER_LEVEL=DEBUG


# =====================================================
# Observability
# =====================================================

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_strong_password

GRAFANA_SMTP_USER=your-email@gmail.com
GRAFANA_SMTP_PASSWORD=your-16-char-app-password

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

SERVICE_VERSION=dev
DEPLOYMENT_ENVIRONMENT=development