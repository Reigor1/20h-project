# =====================================================
# Application
# =====================================================

HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
TIME_ZONE=UTC


# =====================================================
# PostgreSQL
# =====================================================

POSTGRES_USER=test-user-123
POSTGRES_PASSWORD=test-postgres-password-456
POSTGRES_DB=test-db
POSTGRES_TIMEOUT=10s


# =====================================================
# Redis
# =====================================================

REDIS_ADDR=localhost:6379
REDIS_USERNAME=your_redis_username
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_TIMEOUT=5s


# =====================================================
# Kafka Cluster
# =====================================================

KAFKA_CLUSTER_ID=VSBPBFUzaWUPSXRrZDnMRA


# =====================================================
# Kafka Producer
# =====================================================

# Addresses for running todoapp directly on the host.
# Docker Compose overrides this with internal broker addresses.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092,localhost:39092,localhost:49092

KAFKA_CLIENT_ID=20h-project-todoapp

KAFKA_LINGER=5ms
KAFKA_BATCH_SIZE_BYTES=1000000
KAFKA_BATCH_NUM_MESSAGES=10000
KAFKA_COMPRESSION_TYPE=lz4
KAFKA_MESSAGE_TIMEOUT=60s

KAFKA_QUEUE_BUFFERING_MAX_MESSAGES=10000
KAFKA_QUEUE_BUFFERING_MAX_KB=65536


# =====================================================
# Outbox Publisher
# =====================================================

OUTBOX_PUBLISHER_TOPIC=task-events
OUTBOX_PUBLISHER_POLL_INTERVAL=1s
OUTBOX_PUBLISHER_BATCH_SIZE=100
OUTBOX_PUBLISHER_LEASE_DURATION=2m

OUTBOX_PUBLISHER_RETRY_BASE_DELAY=1s
OUTBOX_PUBLISHER_RETRY_MAX_DELAY=5m


# =====================================================
# Kafka Consumer
# =====================================================

KAFKA_CONSUMER_GROUP_ID=activity-workers
KAFKA_CONSUMER_CLIENT_ID=20h-project-activity-worker
KAFKA_CONSUMER_TOPIC=task-events
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_DLQ_TOPIC=task-events.dlq
KAFKA_CONSUMER_RETRY_BASE_DELAY=1s
KAFKA_CONSUMER_RETRY_MAX_DELAY=30s
KAFKA_CONSUMER_MAX_PENDING_MESSAGES=1000


# =====================================================
# Logging
# =====================================================

LOGGER_LEVEL=DEBUG


# =====================================================
# Observability
# =====================================================

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_strong_password

GRAFANA_SMTP_USER=your-email@gmail.com
GRAFANA_SMTP_PASSWORD=your-16-char-app-password

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

SERVICE_VERSION=dev
DEPLOYMENT_ENVIRONMENT=development
